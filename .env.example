# Copia este archivo como .env y llena los valores. Nunca subas .env a git.

# Proyecto de Supabase (Settings > API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública: la usan la app móvil y la web
SUPABASE_ANON_KEY=
# Clave de servicio: SOLO el backend del robot y la simulación. Nunca en la app ni en la web.
SUPABASE_SERVICE_ROLE_KEY=

# Simulación: ruta a x2_ultra.xml (v1.3.0, el X2 Ultra; no X2-Ultra.xml v1.4.0, que es la versión nueva). Si está vacío, se busca en Desktop/Hackaton.
X2_MODELO=
