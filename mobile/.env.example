# Copia este archivo a .env y completa los valores de tu proyecto de Supabase
# (Project Settings > API). Usa SOLO la clave pública (publishable / anon).
# NUNCA pongas aquí la clave service_role: este archivo se empaqueta en la app.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
